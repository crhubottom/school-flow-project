rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /groups/{groupId} {
      function resourceExists() {
        return resource != null;
      }

      function isOwner() {
        return resourceExists()
          && request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      }

      function isMember() {
        return resourceExists()
          && request.auth != null
          && (resource.data.members is list)
          && request.auth.uid in resource.data.members;
      }

      function addsSelfToMembersOnly() {
        return request.auth != null
          && resourceExists()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && (resource.data.members is list)
          && (request.resource.data.members is list)
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && resource.data.members.hasOnly(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1;
      }

      function removesSelfFromMembersOnly() {
        return isSignedIn()
          && resourceExists()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && (resource.data.members is list)
          && (request.resource.data.members is list)
          && (request.auth.uid in resource.data.members)
          && !(request.auth.uid in request.resource.data.members)
          && resource.data.members.size() == request.resource.data.members.size() + 1;
      }

      // Creating a group: must be signed-in and owner equals auth user and they are included in the initial members list
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.members is list)
        && (request.auth.uid in request.resource.data.members);

      // Allow reading group details only to group members.
      // Also allow reads for non-existent docs so clients can check existence (safe because there's nothing to leak).
      allow get: if isSignedIn() && (
        !resourceExists()
        || isMember()
        || isOwner()
      );

      allow list: if isSignedIn();

      // Owner-only updates. Owner UID must not be changed and owner must remain a member.
      allow update: if isSignedIn()
        && resourceExists()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          isOwner()
          || addsSelfToMembersOnly()
          || removesSelfFromMembersOnly()
        );

      // Only owner may delete the group.
      allow delete: if isOwner();

      // Fees subcollection for the group
      match /fees/{feeId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function isGroupMember() {
          return isSignedIn()
            && (groupData().members is list)
            && (request.auth.uid in groupData().members);
        }

        function isGroupOwner() {
          return isSignedIn()
            && groupData().ownerUid == request.auth.uid;
        }

        function isGroupOwnerOrAdmin() {
          return isSignedIn()
            && (
              groupData().ownerUid == request.auth.uid
              || (
                (groupData().admins is list)
                && (request.auth.uid in groupData().admins)
              )
            );
        }

        function isStatusToggleOnly() {
          return isGroupMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && resource.data.status in ['open', 'paid']
            && request.resource.data.status in ['open', 'paid'];
        }

        // Members of the group can read fee documents
        allow read: if isGroupMember();

        // Only group owner or admins (if admins array exists) may create fee documents.
        // Also validate basic shape: amount must be a positive number and createdBy must match the authenticated user.
        allow create: if isGroupOwner()
          && (request.resource.data.amount is number)
          && (request.resource.data.amount > 0)
          && request.resource.data.createdBy == request.auth.uid;

        // Allow updates/deletes by owner or admins (keep simple for now).
        allow update: if isGroupOwnerOrAdmin() || isStatusToggleOnly();

        allow delete: if isGroupOwnerOrAdmin();
      }

      match /users/{userId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if false;
      }
    }
  }
}
